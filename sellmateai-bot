import asyncio
from aiogram import Bot, Dispatcher, types
from aiogram.filters import Command
from datetime import datetime
import sqlite3

TOKEN = 8401624526:AAG6QwuZkW5R-5DNjK5F4YcES7L_9GftlEE

bot = Bot(token=TOKEN)
dp = Dispatcher()

# Database
conn = sqlite3.connect("database.db")
cursor = conn.cursor()
cursor.execute("""
CREATE TABLE IF NOT EXISTS users (
    user_id INTEGER,
    date TEXT,
    count INTEGER
)
""")
conn.commit()

@dp.message(Command("start"))
async def start_handler(message: types.Message):
    await message.answer(
        "🚀 SellMateAI ga xush kelibsiz!\n\n"
        "📸 Rasm yuboring.\n"
        "Kunlik limit: 3 ta."
    )

@dp.message()
async def handle_photo(message: types.Message):
    if not message.photo:
        await message.answer("Iltimos rasm yuboring 📸")
        return

    user_id = message.from_user.id
    today = datetime.now().date().isoformat()

    cursor.execute("SELECT count FROM users WHERE user_id=? AND date=?", (user_id, today))
    row = cursor.fetchone()

    if row:
        if row[0] >= 3:
            await message.answer("❌ Bugungi limit tugadi (3 ta).")
            return
        else:
            cursor.execute(
                "UPDATE users SET count=count+1 WHERE user_id=? AND date=?",
                (user_id, today)
            )
    else:
        cursor.execute(
            "INSERT INTO users VALUES (?, ?, 1)",
            (user_id, today)
        )

    conn.commit()

    await message.answer(
        "🔥 Tayyor marketing caption:\n\n"
        "Sifatli mahsulot 🔥\n"
        "Chegirma mavjud!\n"
        "Hoziroq buyurtma bering!\n\n"
        "#sale #uzshop #biznes"
    )

async def main():
    await dp.start_polling(bot)

if __name__ == "__main__":
    asyncio.run(main())
